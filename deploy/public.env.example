# 只保存在服务器 /etc/english-class/public.env；不发给学生。
DATABASE_PATH=/var/lib/english-class/class.sqlite3
DICTIONARY_PATH=/opt/english-class/data/dictionary.json
CLASS_TIMEZONE=Asia/Shanghai
PUBLIC_HOST=127.0.0.1
# 18080 在部署服务器上已被其他服务占用；修改时同步 nginx 和 create_student.sh 的 PUBLIC_URL。
PUBLIC_PORT=18090

# 官方名称当前为 deepseek-flash；使用中转时改成实际模型ID。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# 代码固定发送 thinking.type=disabled，不发送 reasoning_effort。

# 默认本地Vosk；也可改为http并填写兼容转写接口。
ASR_BACKEND=vosk
VOSK_EN_PATH=/opt/english-class/models/vosk-model-small-en-us-0.15
VOSK_ZH_PATH=/opt/english-class/models/vosk-model-small-cn-0.22
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=
# 以下仅 http 模式生效。Qwen3-ASR 要求语言全名：en:English,zh:Chinese
ASR_LANGUAGE_MAP=
# vosk：云端失败/超时改用本机 Vosk，失败后 ASR_RETRY_AFTER 秒内直接走本机
ASR_FALLBACK=
ASR_TIMEOUT=8
ASR_RETRY_AFTER=60
# 静音/持续噪声不送云端（云端会编出 "Okay."），按没听清处理；0 关闭
ASR_MIN_RMS=200

# 沿用aibot的Edge语音路径；不可用时可配置兼容HTTP TTS。
TTS_BACKEND=edge
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
TTS_BASE_URL=
TTS_MODEL=
TTS_API_KEY=
TTS_VOICE=alloy
