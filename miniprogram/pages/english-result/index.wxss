.page { padding: 44rpx 32rpx 70rpx; }.eyebrow { color: #48678c; font-size: 24rpx; letter-spacing: 2rpx; }.title { font-size: 56rpx; font-weight: 750; margin: 18rpx 0; }.date { color: #6a778a; font-size: 25rpx; margin-bottom: 28rpx; }.summary { background: #e9f0fc; padding: 30rpx; border-radius: 24rpx; margin: 26rpx 0; }.number { font-size: 68rpx; color: #214f9c; font-weight: 700; }.number text { font-size: 28rpx; font-weight: 400; }.line { font-size: 25rpx; line-height: 1.9; color: #385675; }.note { font-size: 24rpx; color: #67758a; line-height: 1.8; }.word-card { background: #fff; border: 1rpx solid #e2e8f0; border-radius: 22rpx; padding: 28rpx; margin: 20rpx 0; }.word-top { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }.word { font-size: 40rpx; font-weight: 650; word-break: break-word; }.meaning { font-size: 28rpx; color: #67758a; margin-top: 10rpx; }.badge { font-size: 23rpx; padding: 9rpx 14rpx; border-radius: 10rpx; flex-shrink: 0; }.state-0 { background: #f7eee0; color: #845b24; }.state-1 { background: #e8effb; color: #2d599e; }.state-2 { background: #e5f3ea; color: #286545; }.unclear { color: #76664e; font-size: 24rpx; line-height: 1.7; border-top: 1rpx solid #edf0f4; padding-top: 18rpx; margin-top: 18rpx; }.empty { background: #fff; padding: 34rpx; margin: 28rpx 0; border-radius: 20rpx; color: #61728b; line-height: 1.9; font-size: 28rpx; }.footnote { margin: 28rpx 4rpx; }.link { text-align: center; color: #315b9f; padding: 22rpx; font-size: 27rpx; }.history { padding: 8rpx 20rpx; background: #fff; border-radius: 20rpx; }.history-row { border-bottom: 1rpx solid #edf1f5; padding: 20rpx 0; }.primary { background: #245ccc; color: #fff; border-radius: 16rpx; margin-top: 30rpx; font-size: 30rpx; }.secondary { background: #eaf0fa; color: #245090; border-radius: 16rpx; margin-top: 20rpx; font-size: 29rpx; }.error { background: #fff0e9; border: 1rpx solid #eec9b4; color: #934117; border-radius: 16rpx; padding: 24rpx; line-height: 1.7; font-size: 26rpx; }
