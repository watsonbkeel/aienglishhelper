.page { padding: 44rpx 32rpx 70rpx; }.eyebrow { color: #48678c; font-size: 24rpx; letter-spacing: 2rpx; }.title { font-size: 58rpx; font-weight: 750; margin: 16rpx 0; }.subtitle { color: #647386; font-size: 28rpx; line-height: 1.7; margin-bottom: 32rpx; }.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin: 24rpx 0; border: 1rpx solid #e2e8f0; }.section-title { font-size: 34rpx; font-weight: 650; margin-bottom: 20rpx; }.row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; min-height: 100rpx; border-bottom: 1rpx solid #edf1f5; }.row:last-child { border-bottom: 0; }.choice { color: #245ccc; padding: 16rpx 0 16rpx 16rpx; }.field-label { margin: 24rpx 0 14rpx; font-size: 28rpx; }.box,.input { background: #f4f6fa; border-radius: 12rpx; padding: 22rpx; min-height: 44rpx; font-size: 27rpx; }.note { color: #68778a; font-size: 24rpx; line-height: 1.7; margin: 12rpx 0; }.preview { border-top: 1rpx solid #edf1f5; padding-top: 20rpx; color: #284669; font-size: 25rpx; line-height: 1.8; }.primary { background: #245ccc; color: #fff; border-radius: 16rpx; margin-top: 32rpx; font-size: 31rpx; }.secondary { background: #eaf0fa; color: #245090; border-radius: 16rpx; margin-top: 20rpx; font-size: 29rpx; }.start-tip { font-size: 25rpx; color: #65758a; line-height: 1.8; margin: 28rpx 4rpx; }.quote { display: block; font-weight: 600; color: #314962; margin: 12rpx 0; }.connection-link { text-align: center; padding: 22rpx; color: #526b8e; font-size: 26rpx; }.error { background: #fff0e9; border: 1rpx solid #eec9b4; color: #934117; border-radius: 16rpx; padding: 24rpx; font-size: 26rpx; line-height: 1.7; }
